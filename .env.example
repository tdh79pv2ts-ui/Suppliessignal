# PostgreSQL
DATABASE_URL="postgresql://suppliesignal:suppliesignal@localhost:5432/suppliesignal?schema=public"

# Supabase Auth (create a project at https://supabase.com)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# API / browser
API_PORT="4000"
WEB_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:4000/api"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Used only for local development when Supabase is intentionally not configured.
# Never enable this in production.
ALLOW_DEV_AUTH="false"
LOG_LEVEL="info"
