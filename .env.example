# PostgreSQL
DATABASE_URL="postgresql://suppliesignal:suppliesignal@localhost:5432/suppliesignal?schema=public"

# Supabase Auth (create a project at https://supabase.com)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# API / browser
NODE_ENV="development"
APP_ENV="development"
API_PORT="4000"
WEB_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:4000/api"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_APP_ENV="development"

# Used only for local development when Supabase is intentionally not configured.
# Never enable this in staging or production.
ALLOW_DEV_AUTH="false"
LOG_LEVEL="info"

# Server-only Phase 4 extraction. Application and tests work with this disabled.
AI_EXTRACTION_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_EXTRACTION_MODEL="gpt-5-mini"
EXTRACTION_BATCH_SIZE="5"

# Phase 5 event processing. Enable only after an auditable Phase 4.5 GO and
# a separate operational activation decision.
EVENT_PROCESSING_ENABLED="false"
EVENT_BATCH_SIZE="5"
EVENT_POLL_MS="60000"
# Calibrate from Phase 4.5 POC results before production activation.
EVENT_MIN_CLAIM_CONFIDENCE="0.60"

# Direct Article -> customer graph news radar POC. Server/worker only.
NEWS_RADAR_ENABLED="true"
NEWS_RADAR_POLL_MS="300000"
NEWS_RADAR_BATCH_SIZE="20"
POC_ARTICLE_BATCH_SIZE="100"

# Optional schema-validated Article translation. The OpenAI key is server-only.
# Original title, summary, language and URL always remain stored unchanged.
ARTICLE_TRANSLATION_ENABLED="false"
ARTICLE_TRANSLATION_MODEL="gpt-5-mini"

# Optional Daily Brief delivery through Resend. Disabled by default.
# These values are server-only and must never receive a VITE_ prefix.
DAILY_BRIEF_EMAIL_ENABLED="false"
RESEND_API_KEY=""
DAILY_BRIEF_FROM_EMAIL=""
