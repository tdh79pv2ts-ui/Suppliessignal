{
  "name": "@suppliesignal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/server.js",
    "start:worker": "node dist/apps/api/src/worker.js",
    "start:extraction-worker": "node dist/apps/api/src/extraction-worker.js",
    "start:event-worker": "node dist/apps/api/src/event-worker.js",
    "start:exposure-worker": "node dist/apps/api/src/exposure-worker.js",
    "start:news-radar-worker": "node dist/apps/api/src/news-radar-worker.js",
    "start:poc-worker": "node dist/apps/api/src/poc-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@suppliesignal/db": "workspace:*",
    "@suppliesignal/ai": "workspace:*",
    "@suppliesignal/ingestion": "workspace:*",
    "@suppliesignal/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3"
  }
}
