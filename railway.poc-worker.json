{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm db:generate && pnpm build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @suppliesignal/api start:poc-worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
