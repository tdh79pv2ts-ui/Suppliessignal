generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REVIEWER
  CUSTOMER
}

enum SupplierTier {
  TIER_1
  TIER_2
  TIER_3
  OTHER
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransportMode {
  ROAD
  RAIL
  SEA
  AIR
  MULTIMODAL
  OTHER
}

enum SourceType {
  RSS
  ATOM
  API
  WEB
  MANUAL
}

enum SourceCategory {
  NEWS
  GOVERNMENT
  REGULATOR
  INDUSTRY
  PORT
  LOGISTICS
  LABOUR
  TRADE
  WEATHER
  OTHER
}

enum SourceReliability {
  LOW
  MEDIUM
  HIGH
  PRIMARY
}

enum SourceArticleStatus {
  COLLECTED
  NORMALIZED
  FAILED
  IGNORED
}

enum CollectionRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum ExtractionRunStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum ClaimType {
  LABOUR_DISRUPTION
  STRIKE
  FACTORY_DISRUPTION
  FACTORY_CLOSURE
  PORT_DISRUPTION
  LOGISTICS_DISRUPTION
  TRANSPORT_DISRUPTION
  WEATHER_DISRUPTION
  NATURAL_HAZARD
  FIRE
  FLOOD
  EARTHQUAKE
  CYCLONE
  TYPHOON
  POLITICAL_DISRUPTION
  CIVIL_UNREST
  TRADE_RESTRICTION
  IMPORT_RESTRICTION
  EXPORT_RESTRICTION
  SANCTION
  REGULATORY_CHANGE
  CUSTOMS_CHANGE
  TARIFF_CHANGE
  MATERIAL_SHORTAGE
  ENERGY_DISRUPTION
  INFRASTRUCTURE_DISRUPTION
  SECURITY_INCIDENT
  OTHER
}

enum AssertionMode {
  OBSERVED
  REPORTED
  ANNOUNCED
  FORECAST
  PLANNED
  ESTIMATED
}

enum ClaimEntityType {
  ORGANIZATION
  COMPANY
  GOVERNMENT
  REGULATOR
  INDUSTRY_ASSOCIATION
  LABOUR_UNION
  FACTORY
  PORT
  AIRPORT
  CITY
  REGION
  COUNTRY
  PRODUCT
  MATERIAL
  COMMODITY
  TRANSPORT_ROUTE
  OTHER
}

model User {
  id          String               @id @db.Uuid
  email       String               @unique
  name        String?
  role        UserRole             @default(CUSTOMER)
  memberships CustomerMembership[]
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model Customer {
  id                    String               @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  defaultAlertThreshold Int                  @default(60) @map("default_alert_threshold")
  memberships           CustomerMembership[]
  suppliers             Supplier[]
  factories             Factory[]
  products              Product[]
  materials             Material[]
  routes                Route[]
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  @@map("customers")
}

model CustomerMembership {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, customerId])
  @@index([customerId])
  @@map("customer_memberships")
}

model Supplier {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name             String
  legalName        String?           @map("legal_name")
  country          String
  city             String?
  latitude         Decimal?          @db.Decimal(9, 6)
  longitude        Decimal?          @db.Decimal(9, 6)
  supplierType     String?           @map("supplier_type")
  tier             SupplierTier
  criticality      Criticality
  active           Boolean           @default(true)
  factories        Factory[]
  supplierProducts SupplierProduct[]
  routeSuppliers   RouteSupplier[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@index([customerId, country])
  @@map("suppliers")
}

model Factory {
  id              String           @id @default(uuid()) @db.Uuid
  customerId      String           @map("customer_id") @db.Uuid
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId      String?          @map("supplier_id") @db.Uuid
  supplier        Supplier?        @relation(fields: [supplierId, customerId], references: [id, customerId], onDelete: Restrict)
  name            String
  address         String?
  country         String
  city            String?
  latitude        Decimal?         @db.Decimal(9, 6)
  longitude       Decimal?         @db.Decimal(9, 6)
  productionType  String?          @map("production_type")
  criticality     Criticality
  active          Boolean          @default(true)
  factoryProducts FactoryProduct[]
  routeFactories  RouteFactory[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@index([customerId, supplierId])
  @@map("factories")
}

model Product {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name             String
  sku              String?
  category         String?
  description      String?
  criticality      Criticality
  active           Boolean           @default(true)
  factoryProducts  FactoryProduct[]
  productMaterials ProductMaterial[]
  supplierProducts SupplierProduct[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@unique([customerId, sku])
  @@index([customerId, active])
  @@map("products")
}

model Material {
  id               String            @id @default(uuid()) @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name             String
  category         String?
  commodity        String?
  criticality      Criticality
  substitutable    Boolean           @default(false)
  active           Boolean           @default(true)
  productMaterials ProductMaterial[]
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@map("materials")
}

model Port {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  country    String
  city       String?
  latitude   Decimal?    @db.Decimal(9, 6)
  longitude  Decimal?    @db.Decimal(9, 6)
  portCode   String?     @unique @map("port_code")
  active     Boolean     @default(true)
  routePorts RoutePort[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([active, country])
  @@map("ports")
}

model Route {
  id               String          @id @default(uuid()) @db.Uuid
  customerId       String          @map("customer_id") @db.Uuid
  customer         Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name             String
  originLabel      String          @map("origin_label")
  destinationLabel String          @map("destination_label")
  transportMode    TransportMode   @map("transport_mode")
  criticality      Criticality
  active           Boolean         @default(true)
  routePorts       RoutePort[]
  routeSuppliers   RouteSupplier[]
  routeFactories   RouteFactory[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@map("routes")
}

model FactoryProduct {
  customerId String   @map("customer_id") @db.Uuid
  factoryId  String   @map("factory_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  factory    Factory  @relation(fields: [factoryId, customerId], references: [id, customerId], onDelete: Restrict)
  product    Product  @relation(fields: [productId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([factoryId, productId])
  @@index([customerId])
  @@map("factory_products")
}

model ProductMaterial {
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  product    Product  @relation(fields: [productId, customerId], references: [id, customerId], onDelete: Restrict)
  material   Material @relation(fields: [materialId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([productId, materialId])
  @@index([customerId])
  @@map("product_materials")
}

model SupplierProduct {
  customerId String   @map("customer_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  supplier   Supplier @relation(fields: [supplierId, customerId], references: [id, customerId], onDelete: Restrict)
  product    Product  @relation(fields: [productId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([supplierId, productId])
  @@index([customerId])
  @@map("supplier_products")
}

model RoutePort {
  customerId String   @map("customer_id") @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  portId     String   @map("port_id") @db.Uuid
  sequence   Int
  route      Route    @relation(fields: [routeId, customerId], references: [id, customerId], onDelete: Restrict)
  port       Port     @relation(fields: [portId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([routeId, portId])
  @@unique([routeId, sequence])
  @@index([customerId])
  @@index([portId])
  @@map("route_ports")
}

model RouteSupplier {
  customerId String   @map("customer_id") @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  route      Route    @relation(fields: [routeId, customerId], references: [id, customerId], onDelete: Restrict)
  supplier   Supplier @relation(fields: [supplierId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([routeId, supplierId])
  @@index([customerId])
  @@map("route_suppliers")
}

model RouteFactory {
  customerId String   @map("customer_id") @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  factoryId  String   @map("factory_id") @db.Uuid
  route      Route    @relation(fields: [routeId, customerId], references: [id, customerId], onDelete: Restrict)
  factory    Factory  @relation(fields: [factoryId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([routeId, factoryId])
  @@index([customerId])
  @@map("route_factories")
}

model Source {
  id                         String                @id @default(uuid()) @db.Uuid
  name                       String
  sourceType                 SourceType            @map("source_type")
  baseUrl                    String                @map("base_url")
  feedUrl                    String?               @map("feed_url")
  country                    String?
  region                     String?
  language                   String?
  category                   SourceCategory
  reliability                SourceReliability
  active                     Boolean               @default(true)
  collectionEnabled          Boolean               @default(false) @map("collection_enabled")
  collectionIntervalMinutes  Int?                  @map("collection_interval_minutes")
  lastCollectedAt            DateTime?             @map("last_collected_at")
  lastSuccessfulCollectionAt DateTime?             @map("last_successful_collection_at")
  lastFailureAt              DateTime?             @map("last_failure_at")
  consecutiveFailures        Int                   @default(0) @map("consecutive_failures")
  articles                   SourceArticle[]
  collectionRuns             SourceCollectionRun[]
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  @@index([active, collectionEnabled])
  @@index([sourceType, category])
  @@map("sources")
}

model SourceArticle {
  id             String              @id @default(uuid()) @db.Uuid
  sourceId       String              @map("source_id") @db.Uuid
  source         Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  originalUrl    String              @map("original_url")
  canonicalUrl   String?             @map("canonical_url")
  externalId     String?             @map("external_id")
  title          String
  author         String?
  publishedAt    DateTime?           @map("published_at")
  discoveredAt   DateTime            @default(now()) @map("discovered_at")
  collectedAt    DateTime            @default(now()) @map("collected_at")
  language       String?
  rawText        String?             @map("raw_text")
  normalizedText String?             @map("normalized_text")
  excerpt        String?
  contentHash    String              @map("content_hash")
  urlHash        String              @map("url_hash")
  status         SourceArticleStatus @default(COLLECTED)
  extractionRuns ArticleExtractionRun[]
  claims         Claim[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([sourceId, externalId])
  @@unique([sourceId, urlHash])
  @@index([sourceId, contentHash])
  @@index([collectedAt, status])
  @@map("source_articles")
}

model ArticleExtractionRun {
  id                String              @id @default(uuid()) @db.Uuid
  sourceArticleId   String              @map("source_article_id") @db.Uuid
  sourceArticle     SourceArticle       @relation(fields: [sourceArticleId], references: [id], onDelete: Restrict)
  status            ExtractionRunStatus @default(PROCESSING)
  provider          String
  model             String
  promptVersion     String              @map("prompt_version")
  schemaVersion     String              @map("schema_version")
  inputHash         String              @map("input_hash")
  inputCharacters   Int                 @map("input_characters")
  inputTruncated    Boolean             @default(false) @map("input_truncated")
  inputTokens       Int?                @map("input_tokens")
  outputTokens      Int?                @map("output_tokens")
  claimsExtracted   Int                 @default(0) @map("claims_extracted")
  articleRelevant   Boolean?            @map("article_relevant")
  startedAt         DateTime            @default(now()) @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  errorCode         String?             @map("error_code")
  errorMessage      String?             @map("error_message")
  claims            Claim[]
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([sourceArticleId, startedAt])
  @@index([status, startedAt])
  @@map("article_extraction_runs")
}

model Claim {
  id              String               @id @default(uuid()) @db.Uuid
  sourceArticleId String               @map("source_article_id") @db.Uuid
  extractionRunId String               @map("extraction_run_id") @db.Uuid
  sourceArticle   SourceArticle        @relation(fields: [sourceArticleId], references: [id], onDelete: Restrict)
  extractionRun   ArticleExtractionRun @relation(fields: [extractionRunId], references: [id], onDelete: Restrict)
  claimType       ClaimType            @map("claim_type")
  assertionMode   AssertionMode        @map("assertion_mode")
  statement       String
  confidence      Decimal              @db.Decimal(4, 3)
  occurredAt      DateTime?            @map("occurred_at")
  validFrom       DateTime?            @map("valid_from")
  validUntil      DateTime?            @map("valid_until")
  evidenceText    String               @map("evidence_text")
  evidenceStart   Int                  @map("evidence_start")
  evidenceEnd     Int                  @map("evidence_end")
  entities        ClaimEntity[]
  locations       ClaimLocation[]
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@index([sourceArticleId, createdAt])
  @@index([extractionRunId])
  @@index([claimType, occurredAt])
  @@map("claims")
}

model ClaimEntity {
  id             String          @id @default(uuid()) @db.Uuid
  claimId        String          @map("claim_id") @db.Uuid
  claim          Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  entityType     ClaimEntityType @map("entity_type")
  name           String
  normalizedName String?         @map("normalized_name")
  role           String?
  confidence     Decimal?        @db.Decimal(4, 3)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([claimId])
  @@index([entityType, name])
  @@map("claim_entities")
}

model ClaimLocation {
  id         String   @id @default(uuid()) @db.Uuid
  claimId    String   @map("claim_id") @db.Uuid
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  name       String
  country    String?
  region     String?
  city       String?
  confidence Decimal? @db.Decimal(4, 3)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([claimId])
  @@index([country, name])
  @@map("claim_locations")
}

model SourceCollectionRun {
  id              String              @id @default(uuid()) @db.Uuid
  sourceId        String              @map("source_id") @db.Uuid
  source          Source              @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  collectorType   SourceType          @map("collector_type")
  startedAt       DateTime            @default(now()) @map("started_at")
  completedAt     DateTime?           @map("completed_at")
  status          CollectionRunStatus @default(RUNNING)
  itemsDiscovered Int                 @default(0) @map("items_discovered")
  itemsCreated    Int                 @default(0) @map("items_created")
  itemsUpdated    Int                 @default(0) @map("items_updated")
  itemsSkipped    Int                 @default(0) @map("items_skipped")
  itemsFailed     Int                 @default(0) @map("items_failed")
  errorCode       String?             @map("error_code")
  errorMessage    String?             @map("error_message")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([sourceId, startedAt])
  @@map("source_collection_runs")
}
