  LABOUR_DISRUPTION
  STRIKE
  FACTORY_DISRUPTION
  FACTORY_CLOSURE
  PORT_DISRUPTION
  LOGISTICS_DISRUPTION
  TRANSPORT_DISRUPTION
  WEATHER_DISRUPTION
  NATURAL_HAZARD
  FIRE
  FLOOD
  EARTHQUAKE
  CYCLONE
  TYPHOON
  POLITICAL_DISRUPTION
  CIVIL_UNREST
  TRADE_RESTRICTION
  IMPORT_RESTRICTION
  EXPORT_RESTRICTION
  SANCTION
  REGULATORY_CHANGE
  CUSTOMS_CHANGE
  TARIFF_CHANGE
  MATERIAL_SHORTAGE
  ENERGY_DISRUPTION
  INFRASTRUCTURE_DISRUPTION
  SECURITY_INCIDENT
  OTHER
}

enum AssertionMode {
  OBSERVED
  REPORTED
  ANNOUNCED
  FORECAST
  PLANNED
  ESTIMATED
}

enum ClaimEntityType {
  ORGANIZATION
  COMPANY
  GOVERNMENT
  REGULATOR
  INDUSTRY_ASSOCIATION
  LABOUR_UNION
  FACTORY
  PORT
  AIRPORT
  CITY
  REGION
  COUNTRY
  PRODUCT
  MATERIAL
  COMMODITY
  TRANSPORT_ROUTE
  OTHER
}

enum PocDatasetStatus {
  DRAFT
  RUNNING
  REVIEWING
  COMPLETED
}

enum PocArticleStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EvaluationScore {
  CORRECT
  PARTIALLY_CORRECT
  INCORRECT
  NOT_APPLICABLE
}

enum EvaluationFailureReason {
  HALLUCINATION
  MISINTERPRETATION
  NEGATION_ERROR
  FORECAST_OBSERVED_ERROR
  DATE_ERROR
  ENTITY_ERROR
  LOCATION_ERROR
  CLAIM_TOO_BROAD
  CLAIM_TOO_FRAGMENTED
  MISSING_CLAIM
  IRRELEVANT_CLAIM
  INSUFFICIENT_ARTICLE_TEXT
  TRUNCATION
  SOURCE_AMBIGUITY
  OTHER
}

enum EventType {
  FACTORY_DISRUPTION
  FACTORY_CLOSURE
  FACTORY_EXPANSION
  PRODUCTION_REDUCTION
  PRODUCTION_INCREASE
  PORT_DISRUPTION
  PORT_CLOSURE
  PORT_CONGESTION
  SHIPPING_DISRUPTION
  LOGISTICS_DISRUPTION
  STRIKE
  LABOR_DISRUPTION
  NATURAL_HAZARD
  WEATHER_DISRUPTION
  FIRE
  EXPLOSION
  ACCIDENT
  POWER_OUTAGE
  CYBER_INCIDENT
  REGULATORY_CHANGE
  TRADE_RESTRICTION
  SANCTION
  TARIFF_CHANGE
  EXPORT_RESTRICTION
  IMPORT_RESTRICTION
  SUPPLIER_DISRUPTION
  MATERIAL_SHORTAGE
  CAPACITY_CHANGE
  OTHER
}

enum EventStatus {
  DETECTED
  ACTIVE
  RESOLVED
  CANCELLED
}

enum EventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventEntityType {
  SUPPLIER
  COMPANY
  FACTORY
  PORT
  AIRPORT
  WAREHOUSE
  DISTRIBUTION_CENTER
  MATERIAL
  PRODUCT
  TRANSPORT_ROUTE
  VESSEL
  REGION
  COUNTRY
  OTHER
}

enum EventLocationType {
  CITY
  REGION
  COUNTRY
  PORT
  FACTORY
  OTHER
}

enum EventTemporalPrecision {
  UNKNOWN
  DAY
  RANGE
}

enum EventConflictState {
  NONE
  DETECTED
}

enum EventMatchDecision {
  CREATE_NEW
  MATCH_EXISTING
  AMBIGUOUS
}

enum ClaimSignal {
  AFFIRMS_EVENT
  DENIES_EVENT
  RESOLUTION_SIGNAL
  CANCELLATION_SIGNAL
  NEUTRAL
}

enum ClaimEventProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  SKIPPED
  FAILED
}

enum ExposureType {
  DIRECT_SUPPLIER
  DIRECT_FACTORY
  DIRECT_PORT
  DIRECT_ROUTE
  DIRECT_MATERIAL
  DIRECT_PRODUCT
  INDIRECT_SUPPLIER
  INDIRECT_FACTORY
  INDIRECT_ROUTE
  GEOGRAPHIC_PROXIMITY
}

enum ExposureStatus {
  POTENTIAL
  CONFIRMED
  DISMISSED
  STALE
  RESOLVED
}

enum ExposureDecision {
  MATCH
  AMBIGUOUS
  NO_MATCH
}

enum ExposureMatchMethod {
  VERIFIED_IDENTIFIER
  REVIEWED_IDENTITY_MAPPING
  GLOBAL_PORT_ID
  PORT_CODE
  COMPOSITE_EXACT_IDENTITY
  EXACT_STRUCTURED_LOCATION
  COORDINATE_PROXIMITY
  EXPLICIT_GRAPH_PATH
}

enum ExposureMatchState {
  VERIFIED_DIRECT
  VERIFIED_INDIRECT
  GEOGRAPHIC
  AMBIGUOUS
}

enum ExposureNodeType {
  SUPPLIER
  FACTORY
  PRODUCT
  MATERIAL
  ROUTE
  PORT
}

enum IdentitySubjectType {
  SUPPLIER
  FACTORY
  PRODUCT
  MATERIAL
  ROUTE
  PORT
}

enum IdentityVerificationStatus {
  PROPOSED
  VERIFIED
  UNVERIFIED
  REJECTED
}

enum ExposureCandidateStatus {
  PENDING
  CONFIRMED
  REJECTED
  SUPERSEDED
}

enum ExposureReasonCode {
  EXACT_SUPPLIER_IDENTIFIER
  EXACT_FACTORY_IDENTIFIER
  EXACT_PRODUCT_IDENTIFIER
  EXACT_MATERIAL_IDENTIFIER
  EXACT_ROUTE_IDENTIFIER
  EXACT_PORT_ID
  EXACT_PORT_CODE
  COMPOSITE_SUPPLIER_IDENTITY
  COMPOSITE_FACTORY_IDENTITY
  ROUTE_CONTAINS_ORIGIN_PORT
  ROUTE_CONTAINS_DESTINATION_PORT
  ROUTE_CONTAINS_INTERMEDIATE_PORT
  EXPLICIT_SUPPLIER_PRODUCT_PATH
  EXPLICIT_FACTORY_PRODUCT_PATH
  EXPLICIT_PRODUCT_MATERIAL_PATH
  EXPLICIT_ROUTE_SUPPLIER_PATH
  EXPLICIT_ROUTE_FACTORY_PATH
  EXACT_COORDINATE_PROXIMITY
  EXACT_CITY_REGION_COUNTRY
  EXACT_REGION_COUNTRY
  COUNTRY_ONLY_PROXIMITY
  AMBIGUOUS_ENTITY_IDENTITY
  AMBIGUOUS_LOCATION
  NAME_ONLY_MATCH_REJECTED
  COUNTRY_MISMATCH
  PORT_COUNTRY_MISMATCH
  FACTORY_NOT_IN_CUSTOMER_GRAPH
  NO_EXPLICIT_GRAPH_PATH
  NODE_ARCHIVED
  NO_SUPPORTED_MATCH
}

model User {
  id                             String                  @id @db.Uuid
  email                          String                  @unique
  name                           String?
  role                           UserRole                @default(CUSTOMER)
  memberships                    CustomerMembership[]
  claimEvaluations               ClaimEvaluation[]
  articleEvaluations             ArticleEvaluation[]
  reviewedExposures              CustomerExposure[]
  verifiedGraphIdentities        CustomerGraphIdentity[]
  proposedEventEntityIdentifiers EventEntityIdentifier[] @relation("EventEntityIdentifierProposer")
  verifiedEventEntityIdentifiers EventEntityIdentifier[] @relation("EventEntityIdentifierVerifier")
  reviewedExposureCandidates     ExposureCandidate[]
  createdAt                      DateTime                @default(now()) @map("created_at")
  updatedAt                      DateTime                @updatedAt @map("updated_at")

  @@map("users")
}

model Customer {
  id                    String                  @id @default(uuid()) @db.Uuid
  name                  String
  description           String?
  defaultAlertThreshold Int                     @default(60) @map("default_alert_threshold")
  memberships           CustomerMembership[]
  suppliers             Supplier[]
  factories             Factory[]
  products              Product[]
  materials             Material[]
  routes                Route[]
  graphRevision         BigInt                  @default(0) @map("graph_revision")
  exposures             CustomerExposure[]
  exposureCandidates    ExposureCandidate[]
  graphIdentities       CustomerGraphIdentity[]
  newsRadarExposures    NewsRadarExposure[]
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  @@map("customers")
}

model CustomerMembership {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, customerId])
  @@index([customerId])
  @@map("customer_memberships")
}

model Supplier {
  id                     String                  @id @default(uuid()) @db.Uuid
  customerId             String                  @map("customer_id") @db.Uuid
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name                   String
  legalName              String?                 @map("legal_name")
  country                String
  city                   String?
  latitude               Decimal?                @db.Decimal(9, 6)
  longitude              Decimal?                @db.Decimal(9, 6)
  supplierType           String?                 @map("supplier_type")
  tier                   SupplierTier
  criticality            Criticality
  active                 Boolean                 @default(true)
  factories              Factory[]
  supplierProducts       SupplierProduct[]
  routeSuppliers         RouteSupplier[]
  exposurePathSteps      ExposurePathStep[]
  exposureCandidateNodes ExposureCandidateNode[]
  graphIdentities        CustomerGraphIdentity[]
  newsRadarExposures     NewsRadarExposure[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@index([customerId, country])
  @@map("suppliers")
}

model Factory {
  id                     String                  @id @default(uuid()) @db.Uuid
  customerId             String                  @map("customer_id") @db.Uuid
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierId             String?                 @map("supplier_id") @db.Uuid
  supplier               Supplier?               @relation(fields: [supplierId, customerId], references: [id, customerId], onDelete: Restrict)
  name                   String
  address                String?
  country                String
  city                   String?
  latitude               Decimal?                @db.Decimal(9, 6)
  longitude              Decimal?                @db.Decimal(9, 6)
  productionType         String?                 @map("production_type")
  criticality            Criticality
  active                 Boolean                 @default(true)
  factoryProducts        FactoryProduct[]
  routeFactories         RouteFactory[]
  exposurePathSteps      ExposurePathStep[]
  exposureCandidateNodes ExposureCandidateNode[]
  graphIdentities        CustomerGraphIdentity[]
  newsRadarExposures     NewsRadarExposure[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@index([customerId, supplierId])
  @@map("factories")
}

model Product {
  id                     String                  @id @default(uuid()) @db.Uuid
  customerId             String                  @map("customer_id") @db.Uuid
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name                   String
  sku                    String?
  category               String?
  description            String?
  criticality            Criticality
  active                 Boolean                 @default(true)
  factoryProducts        FactoryProduct[]
  productMaterials       ProductMaterial[]
  supplierProducts       SupplierProduct[]
  exposurePathSteps      ExposurePathStep[]
  exposureCandidateNodes ExposureCandidateNode[]
  graphIdentities        CustomerGraphIdentity[]
  newsRadarExposures     NewsRadarExposure[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@unique([customerId, sku])
  @@index([customerId, active])
  @@map("products")
}

model Material {
  id                     String                  @id @default(uuid()) @db.Uuid
  customerId             String                  @map("customer_id") @db.Uuid
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name                   String
  category               String?
  commodity              String?
  criticality            Criticality
  substitutable          Boolean                 @default(false)
  active                 Boolean                 @default(true)
  productMaterials       ProductMaterial[]
  exposurePathSteps      ExposurePathStep[]
  exposureCandidateNodes ExposureCandidateNode[]
  graphIdentities        CustomerGraphIdentity[]
  newsRadarExposures     NewsRadarExposure[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@map("materials")
}

model Port {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  country                String
  city                   String?
  latitude               Decimal?                @db.Decimal(9, 6)
  longitude              Decimal?                @db.Decimal(9, 6)
  portCode               String?                 @unique @map("port_code")
  active                 Boolean                 @default(true)
  routePorts             RoutePort[]
  exposurePathSteps      ExposurePathStep[]
  exposureCandidateNodes ExposureCandidateNode[]
  graphIdentities        CustomerGraphIdentity[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@index([active, country])
  @@map("ports")
}

model Route {
  id                     String                  @id @default(uuid()) @db.Uuid
  customerId             String                  @map("customer_id") @db.Uuid
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name                   String
  originLabel            String                  @map("origin_label")
  destinationLabel       String                  @map("destination_label")
  transportMode          TransportMode           @map("transport_mode")
  criticality            Criticality
  active                 Boolean                 @default(true)
  routePorts             RoutePort[]
  routeSuppliers         RouteSupplier[]
  routeFactories         RouteFactory[]
  exposurePathSteps      ExposurePathStep[]
  exposureCandidateNodes ExposureCandidateNode[]
  graphIdentities        CustomerGraphIdentity[]
  newsRadarExposures     NewsRadarExposure[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@unique([id, customerId])
  @@index([customerId, active])
  @@map("routes")
}

model FactoryProduct {
  customerId String   @map("customer_id") @db.Uuid
  factoryId  String   @map("factory_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  factory    Factory  @relation(fields: [factoryId, customerId], references: [id, customerId], onDelete: Restrict)
  product    Product  @relation(fields: [productId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([factoryId, productId])
  @@index([customerId])
  @@map("factory_products")
}

model ProductMaterial {
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  product    Product  @relation(fields: [productId, customerId], references: [id, customerId], onDelete: Restrict)
  material   Material @relation(fields: [materialId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([productId, materialId])
  @@index([customerId])
  @@map("product_materials")
}

model SupplierProduct {
  customerId String   @map("customer_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  supplier   Supplier @relation(fields: [supplierId, customerId], references: [id, customerId], onDelete: Restrict)
  product    Product  @relation(fields: [productId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([supplierId, productId])
  @@index([customerId])
  @@map("supplier_products")
}

model RoutePort {
  customerId         String              @map("customer_id") @db.Uuid
  routeId            String              @map("route_id") @db.Uuid
  portId             String              @map("port_id") @db.Uuid
  sequence           Int
  route              Route               @relation(fields: [routeId, customerId], references: [id, customerId], onDelete: Restrict)
  port               Port                @relation(fields: [portId], references: [id], onDelete: Restrict)
  createdAt          DateTime            @default(now()) @map("created_at")
  newsRadarExposures NewsRadarExposure[]

  @@id([routeId, portId])
  @@unique([routeId, portId, customerId])
  @@unique([routeId, sequence])
  @@index([customerId])
  @@index([portId])
  @@map("route_ports")
}

model RouteSupplier {
  customerId String   @map("customer_id") @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  supplierId String   @map("supplier_id") @db.Uuid
  route      Route    @relation(fields: [routeId, customerId], references: [id, customerId], onDelete: Restrict)
  supplier   Supplier @relation(fields: [supplierId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([routeId, supplierId])
  @@index([customerId])
  @@map("route_suppliers")
}

model RouteFactory {
  customerId String   @map("customer_id") @db.Uuid
  routeId    String   @map("route_id") @db.Uuid
  factoryId  String   @map("factory_id") @db.Uuid
  route      Route    @relation(fields: [routeId, customerId], references: [id, customerId], onDelete: Restrict)
  factory    Factory  @relation(fields: [factoryId, customerId], references: [id, customerId], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([routeId, factoryId])
  @@index([customerId])
  @@map("route_factories")
}

model Source {
  id                         String                @id @default(uuid()) @db.Uuid
  name                       String
  sourceType                 SourceType            @map("source_type")
  baseUrl                    String                @map("base_url")
  feedUrl                    String?               @map("feed_url")
  country                    String?
  region                     String?
  language                   String?
  category                   SourceCategory
  reliability                SourceReliability
  active                     Boolean               @default(true)
  collectionEnabled          Boolean               @default(false) @map("collection_enabled")
  collectionIntervalMinutes  Int?                  @default(15) @map("collection_interval_minutes")
  lastCollectedAt            DateTime?             @map("last_collected_at")
  lastSuccessfulCollectionAt DateTime?             @map("last_successful_collection_at")
  lastFailureAt              DateTime?             @map("last_failure_at")
  consecutiveFailures        Int                   @default(0) @map("consecutive_failures")
  articles                   SourceArticle[]
  collectionRuns             SourceCollectionRun[]
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")

  @@index([active, collectionEnabled])
  @@index([sourceType, category])
  @@map("sources")
}

model SourceArticle {
  id                    String                      @id @default(uuid()) @db.Uuid
  sourceId              String                      @map("source_id") @db.Uuid
  source                Source                      @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  originalUrl           String                      @map("original_url")
  canonicalUrl          String?                     @map("canonical_url")
  externalId            String?                     @map("external_id")
  title                 String
  author                String?
  publishedAt           DateTime?                   @map("published_at")
  discoveredAt          DateTime                    @default(now()) @map("discovered_at")
  collectedAt           DateTime                    @default(now()) @map("collected_at")
  language              String?
  rawText               String?                     @map("raw_text")
  normalizedText        String?                     @map("normalized_text")
  excerpt               String?
  contentHash           String                      @map("content_hash")
  urlHash               String                      @map("url_hash")
  status                SourceArticleStatus         @default(COLLECTED)
  extractionRuns        ArticleExtractionRun[]
  extractionLease       ArticleExtractionLease?
  claims                Claim[]
  pocEvaluationArticles PocEvaluationArticle[]
  newsRadarProcessing   NewsRadarArticleProcessing?
  newsRadarExposures    NewsRadarExposure[]
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  @@unique([sourceId, externalId])
  @@unique([sourceId, urlHash])
  @@index([sourceId, contentHash])
  @@index([collectedAt, status])
  @@map("source_articles")
}

model NewsRadarArticleProcessing {
  sourceArticleId   String                    @id @map("source_article_id") @db.Uuid
  sourceArticle     SourceArticle             @relation(fields: [sourceArticleId], references: [id], onDelete: Cascade)
  status            NewsRadarProcessingStatus @default(RUNNING)
  ownerToken        String                    @map("owner_token") @db.Uuid
  leaseExpiresAt    DateTime                  @map("lease_expires_at")
  attemptCount      Int                       @default(1) @map("attempt_count")
  topics            NewsRadarTopic[]
  detectedTerms     String[]                  @map("detected_terms")
  detectedLocations String[]                  @map("detected_locations")
  completedAt       DateTime?                 @map("completed_at")
  errorCode         String?                   @map("error_code")
  errorMessage      String?                   @map("error_message")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([status, leaseExpiresAt])
  @@map("news_radar_article_processing")
}

model NewsRadarExposure {
  id               String               @id @default(uuid()) @db.Uuid
  customerId       String               @map("customer_id") @db.Uuid
  sourceArticleId  String               @map("source_article_id") @db.Uuid
  matchKey         String               @map("match_key")
  entityType       NewsRadarEntityType  @map("entity_type")
  topic            NewsRadarTopic
  matchMethod      NewsRadarMatchMethod @map("match_method")
  confidence       Decimal              @db.Decimal(4, 3)
  reason           String
  matchedTerms     String[]             @map("matched_terms")
  pathSnapshot     Json                 @map("path_snapshot")
  supplierId       String?              @map("supplier_id") @db.Uuid
  factoryId        String?              @map("factory_id") @db.Uuid
  productId        String?              @map("product_id") @db.Uuid
  materialId       String?              @map("material_id") @db.Uuid
  routeId          String?              @map("route_id") @db.Uuid
  routePortRouteId String?              @map("route_port_route_id") @db.Uuid
  portId           String?              @map("port_id") @db.Uuid
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sourceArticle    SourceArticle        @relation(fields: [sourceArticleId], references: [id], onDelete: Restrict)
  supplier         Supplier?            @relation(fields: [supplierId, customerId], references: [id, customerId], onDelete: Restrict)
  factory          Factory?             @relation(fields: [factoryId, customerId], references: [id, customerId], onDelete: Restrict)
  product          Product?             @relation(fields: [productId, customerId], references: [id, customerId], onDelete: Restrict)
  material         Material?            @relation(fields: [materialId, customerId], references: [id, customerId], onDelete: Restrict)
  route            Route?               @relation(fields: [routeId, customerId], references: [id, customerId], onDelete: Restrict)
  routePort        RoutePort?           @relation(fields: [routePortRouteId, portId, customerId], references: [routeId, portId, customerId], onDelete: Restrict)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@unique([customerId, sourceArticleId, matchKey])
  @@index([customerId, createdAt])
