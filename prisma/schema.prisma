generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  REVIEWER
  CUSTOMER
}

enum SupplierTier {
  TIER_1
  TIER_2
  TIER_3
  OTHER
}

enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TransportMode {
  ROAD
  RAIL
  SEA
  AIR
  MULTIMODAL
  OTHER
}

enum SourceType {
  RSS
  ATOM
  API
  WEB
  MANUAL
}

enum SourceCategory {
  NEWS
  GOVERNMENT
  REGULATOR
  INDUSTRY
  PORT
  LOGISTICS
  LABOUR
  TRADE
  WEATHER
  OTHER
}

enum SourceReliability {
  LOW
  MEDIUM
  HIGH
  PRIMARY
}

enum SourceArticleStatus {
  COLLECTED
  NORMALIZED
  FAILED
  IGNORED
}

enum CollectionRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum NewsRadarTopic {
  GEOPOLITICAL
  ECONOMIC
  OPERATIONAL
  LOGISTICS
  ENVIRONMENTAL
  TRADE
}

enum NewsRadarEntityType {
  SUPPLIER
  FACTORY
  PRODUCT
  MATERIAL
  ROUTE
  PORT
}

enum NewsRadarMatchMethod {
  EXACT_LEGAL_NAME
  UNIQUE_EXACT_NAME
  NAME_AND_LOCATION
  EXACT_CITY_COUNTRY
  EXACT_COUNTRY
  EXACT_PORT_NAME
  EXACT_PORT_CODE
  ROUTE_ENDPOINTS
}

enum NewsRadarProcessingStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ExtractionRunStatus {
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

